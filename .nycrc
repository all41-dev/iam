{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/models/**/*.ts",
    "src/repositories/**/*.ts",
    "src/*.ts",
    "src/api/*.ts",
    "src/db/*.ts",
    "src/utils/*.ts"
  ],
  "reporter": ["lcov", "text"]
}
