{
  "name": "@all41-dev/iam",
  "version": "1.4.1",
  "description": "Library serving user identity and access management",
  "main": "dist/index.js",
  "scripts": {
    "clean": "npx rimraf ./dist",
    "test": "nyc mocha -r ts-node/register src/**/*.spec.ts",
    "lint": "eslint src/** --fix",
    "build": "npm run clean && tsc && npm run copy:scripts",
    "copy:scripts": "cpy ./src/db/scripts ./dist/db/scripts/",
    "start": "node dist/test-index.js",
    "preversion": "run-p test lint build",
    "postversion": "git push && git push --tags && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all41-dev/iam.git"
  },
  "author": "eric@harps.ch",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/all41-dev/iam/issues"
  },
  "homepage": "https://github.com/all41-dev/iam#readme",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/sinon": "^22.0.0",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "mariadb": "^3.5.3",
    "mocha": "^11.8.0",
    "npm-run-all2": "^9.0.2",
    "nyc": "^18.0.0",
    "passport-github2": "^0.1.12",
    "rimraf": "^6.1.3",
    "sinon": "^22.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0"
  },
  "dependencies": {
    "@all41-dev/db-tools": "1.5.1",
    "@all41-dev/server.types": "^1.2.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "uuid": "^14.0.1"
  },
  "volta": {
    "node": "26.5.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
