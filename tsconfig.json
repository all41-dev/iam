{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "module": "commonjs",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "typeRoots": [
      "types",
      "./node_modules/@types"
    ],
    "lib": [
      "ES2021",
      "dom"
    ],
  },
  "include": [
    "./src/**/*.ts"
  ]
}
